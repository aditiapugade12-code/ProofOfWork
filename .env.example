
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT="3000"

# JWT Secret Key for token signing
JWT_SECRET="proofofwork_development_jwt_secret_key_change_in_production"

# MongoDB Connection String (Optional: connects to external or local MongoDB instance; if absent, built-in persistent storage is used)
MONGODB_URI="mongodb://localhost:27017/proofofwork"

# Initial Admin Credentials (used during bootstrap/seed)
ADMIN_EMAIL="admin@proofofwork.edu"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="System Administrator"

